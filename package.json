{
  "name": "dhivehi-language-hub",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "build:data": "node scripts/build-dictionary.mjs",
    "verify:data": "node scripts/verify-pipeline.mjs",
    "translate:draft": "node scripts/translate-en.mjs --mode draft",
    "translate:polish": "node scripts/translate-en.mjs --mode polish",
    "translate:benchmark": "node scripts/translate-en.mjs --benchmark 25",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:assets": "node scripts/generate-mobile-assets.mjs",
    "cap:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-updater": "^8.54.2",
    "@fontsource/noto-sans-thaana": "^5.3.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.72.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ts-fsrs": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@google/genai": "^3.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
